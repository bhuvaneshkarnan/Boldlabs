{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/clinics",
      "destination": "/clinics",
      "permanent": true
    },
    {
      "source": "/clinic",
      "destination": "/clinics",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/", "destination": "/blog/index.html" }
  ]
}
